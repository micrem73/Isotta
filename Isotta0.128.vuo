Comment6 [type="vuo.comment" label="\"parola digitata\"" pos="1875,345" width="1083" height="621" fillcolor="tangerine"];
Comment7 [type="vuo.comment" label="\"scritta indicazioni\"" pos="1140,4440" width="1444" height="609" fillcolor="blue"];
Comment8 [type="vuo.comment" label="\"Execute Shell script non può mandare in esecuzione l'applescript appena generato. Quindi è necessario che Vuo2Ascpt.sh sia in esecuzione. \ Controlla che questo file esista e se esiste lo rinomina e poi lo manda in esecuzione. Anche l'appTwitter deve essere in esecuzione.\"" pos="5355,4605" width="282" height="269"];
