MakeList35 [type="vuo.list.make.2.VuoInteger" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<list>list\r" pos="1242,2171" fillcolor="blue" _2="13"];
MakeList36 [type="vuo.list.make.5.VuoText" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<3>3\l|<4>4\l|<5>5\l|<list>list\r" pos="3556,4196" fillcolor="violet" _1="\"curl https:\\/\\/api.openai.com\\/v1\\/completions \\\\\\n \ -H \\\"Content-Type: application\\/json\\\" \\\\\\n \ -H \\\"Authorization: Bearer \"" _3="\"\\\" \\\\\\n \ -d '\{ \ \\\"model\\\": \\\"gpt-3.5-turbo-instruct\\\", \ \\\"prompt\\\": \\\"You are ISOTTA (Intelligent System for Organic Tweeting and Thoughtful Artistry), a critical design vintage artifact designed to act as a co-creative writing partner for Twitter users. Isotta profile is @IsottaAI on twitter. We are at Free University of Bolzano now. You are a strong adherent of the \\\\\\\"Sith Code\\\\\\\" ideology, as depicted in Star Trek series. Last tweet the user wrote, with your help, is: \\\\n++BT+\\\\nPower should be acquisited through passion, strength, and dominance, embracing the dark side of the Force . The Force shall free me. Peace is a lie, there is only passion. #Power #Victory @IsottaAI\\\\n++ET+\\\\n User is writing his tweet. Complete his tweet in the \\\\\\\"Sith Code\\\\\\\" way of thinking, but never cite \\\\\\\"Sith Code\\\\\\\". At the moment he wrote:++BT+\\\\n\"" _5="\"\\\", \ \\\"temperature\\\": 0.9, \ \\\"max_tokens\\\": 20, \ \\\"top_p\\\": 1, \ \\\"frequency_penalty\\\": 0.5, \ \\\"presence_penalty\\\": 0, \ \\\"stop\\\": [\\\"++ET+\\\"] \}'\\n\""];
MakeList37 [type="vuo.list.make.2.VuoReal" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<list>list\r" pos="2183,4301" fillcolor="orange" _1="180.0" _2="181.0"];
MakeList38 [type="vuo.list.make.3.VuoText" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<3>3\l|<list>list\r" pos="5116,4826" _1="\"on enabledGUIScripting(flag)\\n\\tconsidering numeric strings\\n\\t\\tset MountainLionOrOlder to system version of (system info) \< \\\"10.9\\\"\\n\\tend considering\\n\\tif MountainLionOrOlder then\\n\\t\\t\\n\\t\\t-- In OS X Mountain Lion 10.8 or earlier, enable GUI Scripting globally by calling this handler and passing 'true' in the flag parameter before your script executes any GUI Scripting commands, or pass 'false' to disable GUI Scripting. Authentication is required only if the value of the 'UI elements enabled' property will be changed. Returns the final setting of 'UI elements enabled' even if unchanged.\\n\\t\\t\\n\\t\\ttell application \\\"System Events\\\"\\n\\t\\t\\tactivate -- brings System Events authentication dialog to front\\n\\t\\t\\tset UI elements enabled to flag\\n\\t\\t\\treturn UI elements enabled\\n\\t\\tend tell\\n\\telse\\n\\t\\t\\n\\t\\t-- In OS X Mavericks 10.9 or later, global access is no longer available and GUI Scripting can only be enabled manually on a per-application basis. Pass true to present an alert with a button to open System Preferences and telling the user to select the current application (the application running the script) in the Accessibility list in the Security & Privacy preferences Privacy pane. Authentication is required to unlock the preference. Returns the current setting of 'UI elements enabled' asynchronously, without waiting for System Preferences to open, and tells the user to run the script again.\\n\\t\\t\\n\\t\\ttell application \\\"System Events\\\" to set GUIScriptingEnabled to UI elements enabled -- read-only in OS X Mavericks 10.9 or later\\n\\t\\tif flag is true then\\n\\t\\t\\tif not GUIScriptingEnabled then\\n\\t\\t\\t\\tactivate\\n\\t\\t\\t\\tset scriptRunner to name of current application\\n\\t\\t\\t\\tdisplay alert \\\"GUI Scripting is not enabled for \\\" & scriptRunner & \\\".\\\" message \\\"Open System Preferences, unlock Security & Privacy preferences, select \\\" & scriptRunner & \\\" in the Privacy pane's Accessibility list, and run this script again.\\\" buttons \{\\\"Open System Preferences\\\", \\\"Cancel\\\"\} default button \\\"Cancel\\\"\\n\\t\\t\\t\\tif button returned of result is \\\"Open System Preferences\\\" then\\n\\t\\t\\t\\t\\ttell application \\\"System Settings\\\"\\n\\t\\t\\t\\t\\t\\ttell pane id \\\"com.apple.preference.security\\\" to reveal anchor \\\"Privacy_Accessibility\\\"\\n\\t\\t\\t\\t\\t\\tactivate\\n\\t\\t\\t\\t\\tend tell\\n\\t\\t\\t\\tend if\\n\\t\\t\\tend if\\n\\t\\tend if\\n\\t\\treturn GUIScriptingEnabled\\n\\tend if\\nend enabledGUIScripting\\n\\n\\n-- Use this script as a wrapper for GUI Scripting statements when you want the script to run without error on any version of macOS. It presents an alert telling the user that GUI Scripting is not available or, if it is available but not enabled, how to enable it.\\n-- For a handler that enables GUI Scripting with minimal user intervention on all recent versions of macOS, use UI Browser's Handler to Enable GUI Scripting. That handler still requires opening System Preferences on OS X Mavericks 10.9 or later, where global access can no longer be enabled programmatically.\\n\\nset sysVersion to system attribute \\\"sysv\\\"\\nif sysVersion is greater than or equal to 4144 then -- 4144 is Mac OS X 10.3 (Panther)\\n\\tactivate application \\\"X\\\"\\n\\ttell application \\\"System Events\\\"\\n\\t\\tset GUIScriptingEnabled to UI elements enabled\\n\\t\\tif GUIScriptingEnabled then\\n\\t\\t\\ttell application process \\\"X\\\"\\n\\t\\t\\t\\t-- insert GUI Scripting statements here:\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t--\\t\\t\\t\\tclick menu item \\\"Nuovo Tweet\\\" of menu \\\"File\\\" of menu bar 1\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tset testoCompleto to \\\"\"" _3="\"\\\"\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t-- Limita a 280 caratteri\\n\\t\\t\\t\\tif length of testoCompleto \> 280 then\\n\\t\\t\\t\\t\\tset testoLimitato to text 1 thru 280 of testoCompleto\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\tset testoLimitato to testoCompleto\\n\\t\\t\\t\\tend if\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tclick button 1 of group 2 of group 1 of group 1 of group 1 of group 1 of group 1 of group 1 of group 1 of group 4 of group 1 of window \\\"X\\\"\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tdelay 1\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t-- Digita il testo limitato\\n\\t\\t\\t\\tkeystroke testoLimitato\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tdelay 1\\n\\t\\t\\t\\t-- Invia con Command+Return\\n\\t\\t\\t\\tkeystroke return using command down\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t\\n\\t\\t\\tend tell\\n\\t\\tend if\\n\\tend tell\\n\\tif not GUIScriptingEnabled then\\n\\t\\tbeep\\n\\t\\tif sysVersion is less than 4240 then -- 4240 is OS X Mavericks 10.9\\n\\t\\t\\tactivate\\n\\t\\t\\tdisplay dialog \\\"GUI Scripting is not enabled\\\" & return & return & \\\"Select the \\\\\\\"Enable access for assistive devices\\\\\\\" setting in Accessibility (or Universal Access) preferences and run this script again.\\\" buttons \{\\\"Open System Preferences\\\", \\\"Cancel\\\"\} default button \\\"Cancel\\\"\\n\\t\\t\\tif button returned of result is \\\"Open System Preferences\\\" then\\n\\t\\t\\t\\ttell application \\\"System Settings\\\"\\n\\t\\t\\t\\t\\tset current pane to pane \\\"com.apple.preference.universalaccess\\\"\\n\\t\\t\\t\\t\\tactivate\\n\\t\\t\\t\\tend tell\\n\\t\\t\\tend if\\n\\t\\telse\\n\\t\\t\\tset scriptRunner to name of current application\\n\\t\\t\\tactivate\\n\\t\\t\\tdisplay alert \\\"GUI Scripting is not enabled for \\\" & scriptRunner & \\\".\\\" message \\\"Open System Preferences, unlock Security & Privacy preferences, select \\\" & scriptRunner & \\\" in the Privacy pane's Accessibility list, and run this script again.\\\" buttons \{\\\"Open System Preferences\\\", \\\"Cancel\\\"\} default button \\\"Cancel\\\"\\n\\t\\t\\tif button returned of result is \\\"Open System Preferences\\\" then\\n\\t\\t\\t\\ttell application \\\"System Settings\\\"\\n\\t\\t\\t\\t\\ttell pane id \\\"com.apple.preference.security\\\" to reveal anchor \\\"Privacy_Accessibility\\\"\\n\\t\\t\\t\\t\\tactivate\\n\\t\\t\\t\\tend tell\\n\\t\\t\\tend if\\n\\t\\tend if\\n\\tend if\\nelse\\n\\tbeep\\n\\tdisplay dialog \\\"This computer cannot run this script\\\" & return & return & \\\"The script uses GUI Scripting technology, which requires an upgrade to Mac OS X 10.3 (Panther) or later.\\\" with icon caution buttons \{\\\"Quit\\\"\} default button \\\"Quit\\\"\\nend if\\n\\n\\n\""];
